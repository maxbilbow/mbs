		"controller.animation.miron_golem.flower": {
			"states": {
				"default": {
					"animations": [
						"stored_flower"
					],
					"transitions": [
						{
							"offer_flower": "math.random(0,35300)<1&&!query.is_angry&&!query.is_roaring&&!query.is_stunned&&!query.has_target&&!query.is_sitting&&!query.is_interested&&query.is_alive"
						}
					],
					"blend_transition": 0
				},
				"offer_flower": {
					"animations": [
						"offer_flower"
					],
					"transitions": [
						{
							"offer_flower_still": "query.all_animations_finished||query.is_angry||query.is_sitting||query.has_target||query.is_roaring||!query.is_alive"
						}
					],
					"blend_transition": 0
				},
				"offer_flower_still": {
					"animations": [
						"offer_flower_still"
					],
					"transitions": [
						{
							"put_away_flower": "math.random(0,5300)<1||query.is_angry||query.is_sitting||query.has_target||query.is_roaring||!query.is_alive"
						}
					],
					"blend_transition": 0
				},
				"put_away_flower": {
					"animations": [
						"put_away_flower"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						}
					],
					"blend_transition": 0
				}
			}
		},
