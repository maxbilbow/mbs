{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "mob:merfolk",
			"min_engine_version": "1.16.0",
			"materials": {
				"default": "cat"
			},
			"textures": {
				"pale_default": "textures/entity/merfolk",
				"baby_pale_default": "textures/entity/baby_merfolk",
				"baby_pale_tame": "textures/entity/merfolk_baby_eyes",
				"pale_tame": "textures/entity/merfolk_eyes",
				"pale_angry": "textures/entity/merfolk",
				"baby_pale_angry": "textures/entity/baby_merfolk",
				"ashen_tame": "textures/entity/merfolk_eyes_scrap_metal",
				"baby_ashen_tame": "textures/entity/merfolk_baby_eyes_scrap_metal",
				"black_tame": "textures/entity/merfolk_flower",
				"baby_black_tame": "textures/entity/merfolk_baby_flower",
				"chestnut_tame": "textures/entity/merfolk_hair",
				"baby_chestnut_tame": "textures/entity/merfolk_baby_hair",
				"rusty_tame": "textures/entity/merfolk_crown",
				"baby_rusty_tame": "textures/entity/merfolk_baby_crown",
				"snowy_tame": "textures/entity/merfolk_clothes",
				"baby_snowy_tame": "textures/entity/merfolk_baby_clothes",
				"charged": "textures/entity/merfolk_eyes"
			},
			"geometry": {
				"default": "geometry.merfolk",
				"baby": "geometry.baby_merfolk"
			},
			"scripts": {
				"pre_animation": [
					"v.use_dedicated_baby_armor = true;",
					"variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
					"variable.riding_y_offset_baby_scaling = query.is_baby ? -0.5 : 0.0;",
					"variable.riding_y_offset_with_respect_to_player = 1.0;",
					"variable.riding_y_offset_on_vehicle_where_other_entites_can_stand = query.is_riding_any_entity_of_type('minecraft:minecart', 'minecraft:boat', 'minecraft:chest_boat') ? -3.0 : 0.0;",
					"variable.unscaled_riding_y_offset = variable.riding_y_offset_with_respect_to_player + variable.riding_y_offset_on_vehicle_where_other_entites_can_stand;",
					"variable.riding_y_offset = variable.riding_y_offset_baby_scaling * math.abs(variable.unscaled_riding_y_offset) + variable.unscaled_riding_y_offset + variable.riding_y_offset_baby_scaling * 0.2f;"
				],
				"animate": [
					"look_at_target",
					"move",
					{
						"riding.body": "query.is_riding"
					},
					{
						"riding.arms": "query.is_riding"
					},
					{
						"riding.legs": "query.is_riding"
					},
					"holding",
					{
						"charging": "query.is_charging"
					},
					"attack_controller",
					{
						"brandish_spear": "variable.is_brandishing_spear"
					},
					"bob",
					{
						"damage_nearby_mobs": "variable.damage_nearby_mobs"
					},
					{
						"use_item_progress": "(variable.use_item_interval_progress>0)||(variable.use_item_startup_progress>0)"
					},
					{
						"swimming": "variable.swim_amount>0"
					},
					{
						"water_splat_adult": "query.is_in_water==0&&query.is_sheared"
					},
					{
						"water_splat_baby": "query.is_in_water==0&&query.is_sitting==0&&query.is_baby"
					},
					{
						"baby_sit": "query.is_baby&&query.is_sitting"
					},
					{
						"adult_sit": "query.is_baby==0&&query.is_sitting"
					}
				],
				"should_update_effects_offscreen": 1,
				"scale": "query.is_baby ? 2.0 : 1.0",
				"variables": {
					"variable.use_dedicated_baby_armor": "public"
				}
			},
			"animations": {
				"humanoid_big_head": "animation.humanoid.big_head",
				"look_at_target": "controller.animation.humanoid.look_at_target",
				"look_at_target_default": "animation.humanoid.look_at_target.default",
				"look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
				"look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
				"move": "animation.humanoid.move",
				"riding.arms": "animation.humanoid.riding.arms",
				"riding.legs": "animation.humanoid.riding.legs",
				"holding": "animation.humanoid.holding",
				"brandish_spear": "animation.humanoid.brandish_spear",
				"charging": "animation.humanoid.charging",
				"bob": "animation.merfolk.idle",
				"damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
				"use_item_progress": "animation.humanoid.use_item_progress",
				"attack_rotations": "animation.drowned.attack.rotations",
				"swimming": "animation.zombie.swimming",
				"riding.body": "animation.humanoid.riding.body",
				"water_splat_adult": "animation.merfolk.facedown",
				"water_splat_baby": "animation.baby_merfolk.facedown",
				"baby_sit": "animation.baby_merfolk.sitting",
				"adult_sit": "animation.merfolk.sitting"
			},
			"render_controllers": [
				"controller.render.wolf.v2"
			],
			"spawn_egg": {
				"base_color": "#33826D",
				"overlay_color": "#15FFD6"
			},
			"enable_attachables": true
		}
	}
}