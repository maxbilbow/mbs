						"Texture.dahjacat"
					]
				},
				"geometries": {
					"Array.geos": [
						"Geometry.default",
						"Geometry.snow",
						"Geometry.lush",
						"Geometry.dahjacat"
					]
				}
			},
			"geometry": "array.geos[query.variant]",
