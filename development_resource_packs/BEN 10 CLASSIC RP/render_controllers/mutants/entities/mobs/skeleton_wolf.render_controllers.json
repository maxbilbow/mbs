{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.skeleton_wolf": {
			"is_hurt_color": {
				"r": 1,
				"g": 0,
				"b": 0,
				"a": "(query.is_alive*0.6)+(!query.is_alive*0.6)"
			},
			"geometry": "geometry.default",
			"materials": [
				{
					"*": "material.default"
				}
			],
			"textures": [
				"query.is_angry?texture.angry:(query.has_owner?texture.tame:texture.default)"
			]
		}
	}
}