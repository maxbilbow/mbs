				}
			}
		},
		"controller.animation.punch_break_blocks": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"punch_break_blocks": "query.get_equipped_item_name('main_hand')==''&&variable.attack_time>0.6&&(query.variant==7||query.variant==3||query.variant==5)"
						}
					]
				},
				"punch_break_blocks": {
					"transitions": [
						{
							"default": "variable.attack_time<=0.6"
						}
					],
					"on_entry": [
						"/execute as @s at @s run fill ~-1 ~2 ~-1 ~1 ~0 ~1 air destroy"
					]
				}
			}
		},
		"controller.animation.spacebar_flight": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"fly": "query.is_using_item&&(query.variant==1||query.variant==8)&&(query.get_equipped_item_name('main_hand')=='flight_activator'||query.get_equipped_item_name('main_hand')=='sf_slime')"
						}
					]
				},
				"fly": {
					"transitions": [
						{
							"default": "!query.is_using_item||(query.variant!=1&&query.variant!=8)"
						}
					],
					"on_entry": [
						"/tag @s add jetpack_flying",
						"/tag @s add flying",
						"/execute as @s[variant=1] at @s run playanimation @s animation.heatblast_flying null 0.4",
						"/execute as @s[variant=8] at @s run playanimation @s animation.stinkfly_flying null 0.4"
					],
					"on_exit": [
						"/tag @s remove jetpack_flying",
						"/tag @s remove flying",
						"/execute as @s[variant=1] at @s run playanimation @s animation.heatblast_hover null 0.4",
						"/execute as @s[variant=8] at @s run playanimation @s animation.stinkfly_bob null 0.4"
					]
				}
			}
		},
		"controller.animation.cannonbolt_smash": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"airborne": "(query.variant==5||query.variant==14)&&query.is_sprinting&&!query.is_on_ground"
						}
					]
				},
				"airborne": {
					"transitions": [
						{
							"default": "query.variant!=5&&query.variant!=14"
						},
						{
							"smash": "query.is_on_ground&&query.state_time>=0.5"
						},
						{
							"default": "query.is_on_ground&&query.state_time<0.5"
						}
					]
				},
				"smash": {
					"transitions": [
						{
							"default": "query.state_time>=0.1"
						}
					],
					"on_entry": [
						"/execute as @s[tag=!cb_smash_disabled] at @s run fill ~-2 ~-1 ~-2 ~2 ~-1 ~2 air destroy",
						"/execute as @s[tag=!cb_smash_disabled] at @s run fill ~-1 ~-2 ~-1 ~1 ~-2 ~1 air destroy",
						"/execute as @s[tag=!cb_smash_disabled] at @s run setblock ~ ~-3 ~ air destroy",
						"/execute as @s[tag=!cb_smash_disabled] at @s run damage @e[r=8,rm=0.1,family=monster] 25 entity_attack entity @s",
						"/execute as @s[tag=!cb_smash_disabled] at @s run particle minecraft:sonic_explosion ~ ~1 ~",
						"/execute as @s[tag=!cb_smash_disabled] at @s run particle minecraft:huge_explosion_emitter ~ ~ ~",
						"/execute as @s[tag=!cb_smash_disabled] at @s run camerashake add @a[r=15] 0.8 1.2 positional",
						"/execute as @s[tag=!cb_smash_disabled] at @s run playsound random.explode @a ~ ~ ~ 2.0 0.6"
					]
				}
			}
		},
		"controller.animation.swampfire": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"swampfire": "query.variant==25"
						}
					]
				},
				"swampfire": {
					"transitions": [
						{
							"default": "query.variant!=25"
						}
					],
					"on_entry": [
						"/effect @s fire_resistance 99999 255 true",
						"/effect @s regeneration 99999 0 true",
						"/execute as @s[family=alien] at @s run scriptevent omni:equip_power 1 power:fire_ball"
					]
				}
			}
		},
		"controller.animation.echoecho": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"echoecho": "query.variant==27"
						}
					]
				},
				"echoecho": {
					"transitions": [
						{
							"default": "query.variant!=27"
						}
					],
					"on_entry": [
						"/execute as @s[family=alien] at @s run scriptevent omni:equip_power 1 omni:alien_ee_scream"
