{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.shoot_feed_zap": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"shoot": "query.get_equipped_item_name('main_hand')=='feed_zap'&&query.is_using_item"
						}
					]
				},
				"shoot": {
					"transitions": [
						{
							"default": "query.state_time>=0.15"
						}
					],
					"on_entry": [
						"/scoreboard objectives add lhb dummy",
						"/scoreboard players set @s lhb 0",
						"/scoreboard players set lhb lhb 0",
						"/tag @s add zapping",
						"/event entity @s shoot:feed_zap",
						"/playsound lightning.strike @a ~ ~ ~ 1 2",
						"/execute as @s at @s anchored eyes run particle zk:lightninghitt ^ ^ ^1.0"
					]
				}
			}
		},
		"controller.animation.shoot_feed_sphere": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"throw_and_squeeze": "query.get_equipped_item_name('main_hand')=='feed_sphere'&&query.is_using_item"
						}
					]
				},
				"throw_and_squeeze": {
					"on_entry": [
						"/titleraw @s actionbar {\"rawtext\":[{\"text\":\"§b⚡ Squeezing Mobs... Release to DETONATE!\"}]}",
						"/scoreboard objectives add strikedl dummy",
						"/event entity @s shoot:feed_sphere",
						"/playsound mob.wither.shoot @a ~ ~ ~ 1 0.5"
					],
					"transitions": [
						{
							"detonate": "!query.is_using_item"
						}
					]
				},
				"detonate": {
					"on_entry": [
						"/titleraw @s actionbar {\"rawtext\":[{\"text\":\"§c💥 DETONATED! 💥\"}]}",
						"/event entity @e[type=zk:greaterlightningmagiccircle,r=100] power:release",
						"/tag @s add detonating"
					],
					"transitions": [
						{
							"cooldown": "query.state_time>=3"
						}
					]
				},
				"cooldown": {
					"on_entry": [
						"/tag @s remove detonating"
					],
					"transitions": [
						{
							"default": "!query.is_using_item"
						}
					]
				}
			}
		},
