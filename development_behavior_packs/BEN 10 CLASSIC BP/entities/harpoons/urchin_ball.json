{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "projectile:urchin_ball",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"runtime_identifier": "minecraft:snowball"
		},
		"component_groups": {
			"can_pick_up": {
				"minecraft:timer": {
					"looping": true,
					"time": [
						20,
						30
					],
					"time_down_event": {
						"event": "despawn"
					}
				},
				"minecraft:area_attack": {
					"damage_range": 1,
					"damage_per_tick": 8,
					"cause": "contact",
					"entity_filter": {
						"any_of": [
							{
								"test": "is_family",
								"subject": "other",
								"value": "player"
							},
							{
								"test": "is_family",
								"subject": "other",
								"value": "monster"
							}
						]
					}
				}
			},
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"in_water": {
				"minecraft:projectile": {
					"on_hit": {
						"impact_damage": {
							"catch_fire": true,
							"knockback": true,
							"semi_random_diff_damage": false,
							"destroy_on_hit": false
						},
						"stick_in_ground": {
							"shake_time": 0
						},
						"definition_event": {
							"event_trigger": {
								"event": "can_pick_up"
							}
						}
					},
					"liquid_inertia": 0.7,
					"power": 2.5,
					"gravity": 0,
					"uncertainty_base": 1,
					"uncertainty_multiplier": 0,
					"stop_on_hurt": true,
					"anchor": 1,
					"should_bounce": true,
					"multiple_targets": false,
					"offset": [
						0,
						-0.1,
						0
					]
				},
				"minecraft:environment_sensor": {
					"triggers": {
						"event": "entered_air",
						"filters": {
							"test": "is_underwater",
							"value": false
						}
					}
				},
				"minecraft:timer": {
					"looping": true,
					"time": [
						1.2,
						1.2
					],
					"time_down_event": {
						"event": "floating"
					}
				}
			},
			"in_air": {
				"minecraft:projectile": {
					"on_hit": {
						"impact_damage": {
							"catch_fire": true,
							"knockback": false,
							"semi_random_diff_damage": false,
							"destroy_on_hit": false
						},
						"stick_in_ground": {
							"shake_time": 0
						},
						"definition_event": {
							"event_trigger": {
								"event": "despawn"
							}
						}
					},
					"liquid_inertia": 0.99,
					"hit_sound": "item.trident.hit",
					"hit_ground_sound": "item.trident.hit_ground",
					"power": 2.5,
					"gravity": 0.2,
					"uncertainty_base": 1,
					"uncertainty_multiplier": 0,
					"stop_on_hurt": true,
					"anchor": 1,
					"should_bounce": true,
					"multiple_targets": false,
					"offset": [
						0,
						-0.1,
						0
					],
					"inertia": 0.75
				}
			},
			"explode": {
				"minecraft:explode": {
					"fuse_length": 0,
					"fuse_lit": true,
					"power": 0,
					"causes_fire": false,
					"fire_affected_by_griefing": true,
					"destroy_affected_by_griefing": true
				}
			}
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.5,
				"height": 0.35
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			"minecraft:conditional_bandwidth_optimization": {
				"default_values": {
					"max_optimized_distance": 1000,
					"max_dropped_ticks": 7,
					"use_motion_prediction_hints": true
				}
			}
		},
		"events": {
			"pick_up": {
				"queue_command": {
					"command": [
						"give @p[r=5] sword:copper_harpoon",
						"kill @s"
					]
				},
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			},
			"can_pick_up": {
				"randomize": [
					{
						"add": {
							"component_groups": [
								"explode"
							]
						}
					}
				]
			},
			"minecraft:entity_spawned": {
				"sequence": [
					{
						"filters": {
							"test": "is_underwater",
							"value": true
						},
						"add": {
							"component_groups": [
								"in_water"
							]
						}
					},
					{
						"filters": {
							"test": "is_underwater",
							"value": false
						},
						"add": {
							"component_groups": [
								"in_air"
							]
						}
					}
				]
			},
			"entered_air": {
				"sequence": [
					{
						"remove": {
							"component_groups": [
								"in_water"
							]
						}
					},
					{
						"add": {
							"component_groups": [
								"in_air"
							]
						}
					}
				]
			},
			"floating": {
				"add": {
					"component_groups": [
						"can_pick_up"
					]
				}
			},
			"despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			}
		}
	}
}