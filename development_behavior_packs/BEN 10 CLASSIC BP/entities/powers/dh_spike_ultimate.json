		},
		"events": {
			"despawn": {
				"sequence": [
					{
						"run_command": {
							"command": [
								"event entity @s minecraft:entity_despawn"
							]
						}
					}
				]
			},
			"power:start_despawn": {
				"add": {
					"component_groups": [
						"despawning"
					]
				}
			},
			"power:despawn": {
				"add": {
					"component_groups": [
						"despawning"
					]
				},
				"sequence": [
					{
						"run_command": {
							"command": [
								"event entity @s minecraft:entity_despawn"
							]
						}
					}
				]
			},
			"minecraft:entity_despawn": {
				"add": {
					"component_groups": [
						"despawning"
					]
				},
				"sequence": [
					{
						"run_command": {
							"command": [
								"kill @s"
							]
						}
					}
				]
			}
