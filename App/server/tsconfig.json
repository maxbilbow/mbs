{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["esnext"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "strict": true
  },
  "include": ["./**/*.ts", "../../scripts/**/*.ts", "../../tests/**/*.ts"]
}
