{
  "name": "max-mbs",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env ./App/server/start.ts",
    "build": "esbuild ./App/client/main.tsx ./App/client/auth.ts --bundle --minify --define:process.env.NODE_ENV=\\\"production\\\" --outdir=./App/www/js --loader:.css=global-css",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p App/server && tsc -p App/client && tsc -p plugins/max",
    "bedrock": "node scripts/bedrock.ts",
    "bedrock:update": "node update-server.ts",
    "plugins:build": "node scripts/plugins.ts build",
    "plugins:deploy": "node scripts/plugins.ts deploy"
  },
  "author": "Max Bilbow",
  "license": "ISC",
  "imports": {
    "#bedrock_server": "./bedrock/bedrock_server",
    "#current_version.txt": "./bedrock/current_version.txt"
  },
  "devDependencies": {
    "@minecraft/common": "^1.3.0",
    "@minecraft/diagnostics": "^1.0.0-beta.1.21.70-preview.22",
    "@minecraft/server": "^2.8.0",
    "@minecraft/server-ui": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "prettier": "3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "semver": "^7.7.4",
    "tslog": "^4.10.2",
    "typescript": "^6.0.2"
  }
}
