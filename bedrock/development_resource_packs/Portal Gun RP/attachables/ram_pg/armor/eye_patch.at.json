{
    "format_version": "1.20.30",
    "minecraft:attachable": {
      "description": {
        "identifier": "ram_pg:eye_patch",
        "item": { "ram_pg:eye_patch": "query.is_owner_identifier_any('minecraft:player')" },
        "materials": {
          "default": "armor",
          "enchanted": "armor_enchanted"
        },
        "textures": {
          "default": "textures/ram_pg/attachable/armor/eye_patch",
          "enchanted": "textures/misc/enchanted_item_glint"
        },
        "geometry": {
          "default": "geometry.ram_pg.eye_patch"
        },
        "scripts": {
          "parent_setup": "variable.helmet_layer_visible = 0.0;"
        },
        "render_controllers": ["controller.render.armor"]
      }
    }
  }
