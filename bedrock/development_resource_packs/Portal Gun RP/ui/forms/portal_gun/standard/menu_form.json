{
  "namespace": "standard_menu_form",
  "charge_bar_animation": {
    "anim_type": "flip_book",
    "initial_uv": [0, 0],
    "frame_count": 8,
    "frame_step": 100,
    "fps": 8,
    "looping": true
  },
  "custom_button": {
    "$default_button_background_texture|default": "textures/ram_pg/ui/presets/red_ore-ui_style/red_default_button",
    "$hover_button_background_texture|default": "textures/ram_pg/ui/presets/red_ore-ui_style/red_hover_button",
    "$pressed_button_background_texture|default": "textures/ram_pg/ui/presets/red_ore-ui_style/red_pressed_button",
    "$button_size|default": [64, 64],
    "$button_offset|default": [0, 0],
    "$icon_size|default": [45, 45],
    "$icon_offset|default": [0, -5],
    "$text_offset|default": [0, -8],
    "$font_size|default": 1,
    "$font_type|default": "MinecraftRegular",
    "$shadow|default": false,
    "$text_alignment|default": "left",
    "$show_hover_text|default": false,
    "type": "panel",
    "size": "$button_size",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "panel_name": {
          "type": "panel",
          "size": "$button_size",
          "offset": "$button_offset",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "image": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "type": "image",
                "layer": 200,
                "size": "$icon_size",
                "offset": "$icon_offset",
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "text": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "type": "label",
                "text": "#form_button_text",
                "font_type": "$font_type",
                "font_scale_factor": "$font_size",
                "layer": 5,
                "text_alignment": "$text_alignment",
                "shadow": "$shadow",
                "offset": "$text_offset",
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "form_button@common_buttons.light_content_button": {
          "$default_button_texture": "$default_button_background_texture",
          "$hover_button_texture": "$hover_button_background_texture",
          "$pressed_button_texture": "$pressed_button_background_texture",
          "$default_state_border_visible": false,
          "$hover_state_border_visible": false,
          "$pressed_state_border_visible": false,
          "$pressed_button_name": "button.form_button_click",
          "offset": "$button_offset",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": "$button_size",
          "$button_text": "#null",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": ["100%", 20],
          "variables": [
            {
              "requires": "($show_hover_text)",
              "$button_content": "default_namespace.hover_text_panel"
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_button_text = '') )",
        "target_property_name": "#visible"
      }
    ]
  },
  "menu": {
    "type": "panel",
    "bindings": [],
    "controls": [
      {
        "bg-image": {
          "offset": [0, 0],
          "size": [10000, 10000],
          "type": "image",
          "texture": "textures/ram_pg/ui/pg_ui/menu/black_bg",
          "anchor_from": "center",
          "anchor_to": "center",
          "bindings": [],
          "controls": [
            {
              "gun-image": {
                "anchor_from": "center",
                "anchor_to": "center",
                "type": "image",
                "layer": 1,
                "size": [850, 850],
                "texture": "#texture",
                "bindings": [
                  {
                    "binding_name": "#form_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((%.100s * (#form_text - (%.0s * #form_text))) - '\t')",
                    "target_property_name": "#texture"
                  }
                ],
                "controls": [
                  {
                    "menu-collection_panel": {
                      "offset": [0, -15],
                      "size": [250, 110],
                      "layer": 4,
                      "type": "collection_panel",
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "collection_name": "form_buttons",
                      "bindings": [],
                      "controls": [
                        {
                          "saved-locations-button@standard_menu_form.custom_button": {
                            "$button_offset": [30, 10],
                            "$button_size": [90, 90],
                            "layer": 6,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "collection_index": 0,
                            "$icon_offset": [3.5, 1],
                            "$icon_size": [80, 80],
                            "$font_size": 0.9,
                            "$text_offset": [7.4, 75],
                            "$font_type": "MinecraftRegular",
                            "$shadow": true,
                            "$text_alignment": "center",
                            "$show_hover_text": false,
                            "bindings": []
                          }
                        },
                        {
                          "set-coordinates-button@standard_menu_form.custom_button": {
                            "$button_offset": [120, 10],
                            "$button_size": [105, 30],
                            "layer": 6,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "collection_index": 1,
                            "$icon_offset": [3.5, 3],
                            "$icon_size": [20, 20],
                            "$font_size": 0.9,
                            "$text_offset": [25, 10],
                            "$font_type": "MinecraftRegular",
                            "$shadow": true,
                            "$text_alignment": "center",
                            "$show_hover_text": false,
                            "bindings": []
                          }
                        },
                        {
                          "select-mode-button@standard_menu_form.custom_button": {
                            "$button_offset": [120, 40],
                            "$button_size": [105, 30],
                            "layer": 6,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "collection_index": 2,
                            "$icon_offset": [3.5, 1],
                            "$icon_size": [20, 25],
                            "$font_size": 0.9,
                            "$text_offset": [30, 10],
                            "$font_type": "MinecraftRegular",
                            "$shadow": true,
                            "$text_alignment": "center",
                            "$show_hover_text": false,
                            "bindings": []
                          }
                        },
                        {
                          "settings-button@standard_menu_form.custom_button": {
                            "$button_offset": [120, 70],
                            "$button_size": [30, 30],
                            "layer": 6,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "collection_index": 3,
                            "$icon_offset": [4.7, 3.2],
                            "$icon_size": [20, 20],
                            "bindings": []
                          }
                        },
                        {
                          "behavior-settings-button@standard_menu_form.custom_button": {
                            "$button_offset": [155, 70],
                            "$button_size": [30, 30],
                            "layer": 6,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "collection_index": 4,
                            "$icon_offset": [4.7, 3.2],
                            "$icon_size": [20, 20],
                            "bindings": []
                          }
                        },
                        {
                          "history-button@standard_menu_form.custom_button": {
                            "$button_offset": [190, 70],
                            "$button_size": [30, 30],
                            "layer": 6,
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "collection_index": 5,
                            "$icon_offset": [4.7, 3.2],
                            "$icon_size": [20, 20],
                            "bindings": []
                          }
                        },
                        {
                          "charge_bar": {
                            "type": "image",
                            "texture": "#texture",
                            "size": [100, 9],
                            "uv_size": [100, 9],
                            "uv": "@standard_menu_form.charge_bar_animation",
                            "disable_anim_fast_forward": true,
                            "offset": [123, 101],
                            "anchor_from": "top_left",
                            "anchor_to": "top_left",
                            "layer": 8,
                            "bindings": [
                              { "binding_name": "#form_text" },
                              {
                                "binding_type": "view",
                                "source_property_name": "((%.100s * (#form_text - (%.100s * #form_text))) - '\t')",
                                "target_property_name": "#texture"
                              }
                            ]
                          }
                        },
                        {
                          "close-button@standard_menu_form.custom_button": {
                            "$button_offset": [80, -10],
                            "$button_size": [30, 30],
                            "layer": 6,
                            "anchor_from": "top_right",
                            "anchor_to": "top_right",
                            "collection_index": 6,
                            "$icon_offset": [4.7, 3.2],
                            "$icon_size": [20, 20],
                            "bindings": []
                          }
                        },
                        {
                          "unplug-tube-button@standard_menu_form.custom_button": {
                            "$default_button_background_texture": "textures/ram_pg/ui/presets/turquoise_ore-ui_style/turquoise_default_button",
                            "$hover_button_background_texture": "textures/ram_pg/ui/presets/turquoise_ore-ui_style/turquoise_hover_button",
                            "$pressed_button_background_texture": "textures/ram_pg/ui/presets/red_ore-ui_style/red_pressed_button",
                            "$button_offset": [80, -40],
                            "$button_size": [30, 30],
                            "layer": 6,
                            "anchor_from": "top_right",
                            "anchor_to": "top_right",
                            "collection_index": 7,
                            "$icon_offset": [4.7, 3.2],
                            "$icon_size": [20, 20],
                            "bindings": []
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
