{
  "namespace": "pg_proto",
  "button@pg_forms.button": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ],
    "$pg_button_text_color": [
      0.9,
      0.95,
      1
    ],
    "$default_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_default_proto",
    "$hover_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_hover_proto",
    "$pressed_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_pressed_proto"
  },
  "list_icon_button@pg_forms.list_icon_button": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ],
    "$pg_button_text_color": [
      0.9,
      0.95,
      1
    ],
    "$default_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_default_proto",
    "$hover_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_hover_proto",
    "$pressed_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_pressed_proto"
  },
  "buttons_panel": {
    "type": "stack_panel",
    "size": [
      "100% - 4px",
      "100%c"
    ],
    "offset": [
      2,
      0
    ],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "pg_proto.button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "action_form@pg_forms.action_form": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ],
    "$pg_text_color": [
      0.82,
      0.89,
      0.96
    ],
    "$pg_button_text_color": [
      0.9,
      0.95,
      1
    ],
    "$pg_buttons_panel": "pg_proto.buttons_panel",
    "$pg_panel_texture": "textures/ram_pg/ui/pg_ui/scifi/panel_bg_proto",
    "$pg_viewport_texture": "textures/ram_pg/ui/pg_ui/scifi/viewport_bg_proto",
    "$default_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_default_proto",
    "$hover_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_hover_proto",
    "$pressed_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_pressed_proto"
  },
  "list_form@pg_proto.action_form": {
    "$pg_hide_viewport": true,
    "$pg_buttons_panel": "pg_forms.list_panel",
    "$pg_list_button": "pg_proto.button",
    "$pg_list_icon_button": "pg_proto.list_icon_button"
  },
  "custom_form@pg_forms.custom_form": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ],
    "$pg_text_color": [
      0.82,
      0.89,
      0.96
    ],
    "$pg_button_text_color": [
      0.9,
      0.95,
      1
    ],
    "$pg_buttons_panel": "pg_proto.buttons_panel",
    "$pg_panel_texture": "textures/ram_pg/ui/pg_ui/scifi/panel_bg_proto",
    "$pg_viewport_texture": "textures/ram_pg/ui/pg_ui/scifi/viewport_bg_proto",
    "$default_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_default_proto",
    "$hover_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_hover_proto",
    "$pressed_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_pressed_proto"
  },
  "terminal_form@pg_forms.terminal_form": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ],
    "$pg_text_color": [
      0.82,
      0.89,
      0.96
    ],
    "$pg_button_text_color": [
      0.9,
      0.95,
      1
    ],
    "$pg_buttons_panel": "pg_proto.buttons_panel",
    "$pg_panel_texture": "textures/ram_pg/ui/pg_ui/scifi/panel_bg_proto",
    "$pg_viewport_texture": "textures/ram_pg/ui/pg_ui/scifi/viewport_bg_proto",
    "$default_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_default",
    "$hover_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_hover_proto",
    "$pressed_button_texture": "textures/ram_pg/ui/pg_ui/scifi/button_pressed_proto",
    "$pg_term_contents": "pg_proto.term_contents"
  },
  "term_line@pg_forms.term_line": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ]
  },
  "term_input@pg_forms.term_input": {
    "$pg_accent": [
      0.35,
      1,
      0.47
    ]
  },
  "term_contents@pg_forms.term_contents": {
    "factory": {
      "name": "buttons",
      "control_ids": {
        "label": "@pg_proto.term_line",
        "toggle": "@server_form.custom_toggle",
        "slider": "@server_form.custom_slider",
        "step_slider": "@server_form.custom_step_slider",
        "dropdown": "@server_form.custom_dropdown",
        "input": "@pg_proto.term_input",
        "header": "@pg_forms.hidden_entry",
        "divider": "@settings_common.option_group_section_divider",
        "multiselect": "@server_form.custom_multiselect"
      }
    }
  }
}
