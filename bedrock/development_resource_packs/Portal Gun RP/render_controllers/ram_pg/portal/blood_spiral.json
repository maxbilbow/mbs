{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.portal_blood_spiral": {
			"geometry": "geometry.blood_spiral",
			"materials": [
				{
					"*": "material.blood_spiral"
				}
			],
			"textures": ["texture.blood_spiral"],
			"uv_anim": {
				"scale": [1, "1 / 60"],
				"offset": ["-0.0286", "(math.min(59, math.floor((query.life_time - variable.blood_spiral_start) * 15)) - 0.0554) / 60"]
			},
			"ignore_lighting": true
		}
	}
}
