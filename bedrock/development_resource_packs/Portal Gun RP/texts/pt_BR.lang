ram_pg.select_mode.explained.header=Modos explicados:
ram_pg.select_mode.explained.fifo=§eFIFO§r - First In, First Out:\nApós ter 2 portais ativos, cada novo portal substitui o mais antigo.
ram_pg.select_mode.explained.lifo=§eLIFO§r - Last In, First Out:\nApós ter 2 portais ativos, cada novo portal substitui o mais recente.
ram_pg.select_mode.explained.multipair=§eMulti-Par§r:\nPermite ter vários pares de portais ativos ao mesmo tempo (máximo de 10). Você pode entrar em qualquer portal e sair pelo seu par.
ram_pg.select_mode.explained.root=§eRaiz§r:\nAtira um portal que age como âncora. Você pode atirar vários portais (máximo de 10), mas ao entrar em qualquer um deles, sempre sairá pelo portal raiz (o primeiro criado). Entrar no portal raiz te leva de volta ao último portal atirado.
ram_pg.select_mode.explained.custom=§eCUSTOM§r:\nFunciona exatamente como o modo Raiz, mas o portal raiz sempre fica no local customizado que você definiu. Esse modo só fica ativo quando você define um local customizado.
ram_pg.select_mode.explained.target=§eAlvo§r:\nBata no ar, ou agache e pule, mirando um bloco para defini-lo como alvo. O próximo portal se liga a um portal raiz aberto exatamente naquele bloco (o posicionamento seguro é ignorado), e os seguintes funcionam como no modo Raiz. Definir um novo alvo recomeça tudo.
ram_pg.target.marked=§aAlvo definido: X %s, Y %s, Z %s. O próximo portal vai se ligar a ele.§r
ram_pg.target.none=§eNenhum alvo ainda: bata no ar (ou agache e pule) mirando um bloco para definir.§r
ram_pg.target.no_block=§cNenhum bloco à vista para mirar.§r
ram_pg.select_mode.set_mode=§aModo definido para %s.§r

