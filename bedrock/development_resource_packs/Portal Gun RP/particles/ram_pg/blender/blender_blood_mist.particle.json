{
	"format_version": "1.21.10",
	"particle_effect": {
		"description": {
			"identifier": "ram_pg:blender_blood_mist",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/ram_pg/particles/blender/blood_mist"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "30 * (variable.intensity ?? 1)",
				"max_particles": 90
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": "variable.duration"
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.3,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.7 + 0.5 * variable.particle_random_2"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "360 * variable.particle_random_3",
				"rotation_rate": "40 - 80 * variable.particle_random_4"
			},
			"minecraft:particle_initial_speed": "0.4 + 0.5 * variable.particle_random_1",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -0.6, 0],
				"linear_drag_coefficient": 2.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.12 + 0.2 * variable.particle_age / variable.particle_lifetime",
					"0.12 + 0.2 * variable.particle_age / variable.particle_lifetime"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": ["variable.fluid_r ?? 0.55", "variable.fluid_g ?? 0.04", "variable.fluid_b ?? 0.04", "0.4 * (1 - variable.particle_age / variable.particle_lifetime)"]
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}
