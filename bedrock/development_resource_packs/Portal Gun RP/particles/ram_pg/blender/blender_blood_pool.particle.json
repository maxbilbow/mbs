{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "ram_pg:blender_blood_pool",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/ram_pg/particles/portal_fluid/fluid_ground_drop"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "variable.splats ?? 8"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, "0.02 + 0.015 * variable.particle_random_4", 0],
				"half_dimensions": [0.5, 0, 0.5],
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "6 + 3 * variable.particle_random_2"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "360 * variable.particle_random_3"
			},
			"minecraft:particle_initial_speed": 0.8,
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 5
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.22 + 0.4 * variable.particle_random_1", "0.22 + 0.4 * variable.particle_random_1"],
				"facing_camera_mode": "emitter_transform_xz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"uv": [
						0,
						"16 * (variable.particle_age / variable.particle_lifetime < 0.12 ? math.floor((variable.particle_age / variable.particle_lifetime) * 41.67) : (variable.particle_age / variable.particle_lifetime < 0.65 ? 4 : math.min(11, 4 + math.floor((variable.particle_age / variable.particle_lifetime - 0.65) * 22.86))))"
					],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"(variable.fluid_r ?? 0.7) * (1 - 0.6 * variable.particle_age / variable.particle_lifetime)",
					"(variable.fluid_g ?? 0.067) * (1 - 0.6 * variable.particle_age / variable.particle_lifetime)",
					"(variable.fluid_b ?? 0.05) * (1 - 0.6 * variable.particle_age / variable.particle_lifetime)",
					1
				]
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}
