					"0.15 * math.sqrt(1 - (2 * variable.particle_random_1 - 1) * (2 * variable.particle_random_1 - 1)) * math.cos(360 * variable.particle_random_2)",
					"0.15 * (2 * variable.particle_random_1 - 1)",
					"0.15 * math.sqrt(1 - (2 * variable.particle_random_1 - 1) * (2 * variable.particle_random_1 - 1)) * math.sin(360 * variable.particle_random_2)"
				],
				"direction": [
					"math.sqrt(1 - (2 * variable.particle_random_1 - 1) * (2 * variable.particle_random_1 - 1)) * math.cos(360 * variable.particle_random_2) + 0.9 * variable.nx",
					"(2 * variable.particle_random_1 - 1) + 0.9 * variable.ny",
					"math.sqrt(1 - (2 * variable.particle_random_1 - 1) * (2 * variable.particle_random_1 - 1)) * math.sin(360 * variable.particle_random_2) + 0.9 * variable.nz"
				]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "1.3 + 0.9 * variable.particle_random_4"
			},
			"minecraft:particle_initial_speed": "3 + 4.5 * variable.particle_random_3",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -13, 0],
				"linear_drag_coefficient": 1.1
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.04,
				"coefficient_of_restitution": 0,
				"collision_drag": 7,
				"expire_on_contact": false
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.11 * math.clamp((1 - variable.particle_age / variable.particle_lifetime) * 3.5, 0, 1)",
					"0.055 * math.clamp((1 - variable.particle_age / variable.particle_lifetime) * 3.5, 0, 1)"
				],
				"facing_camera_mode": "lookat_direction",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 0.05
				},
				"uv": {
					"texture_width": 64,
					"texture_height": 8,
					"uv": ["16 * math.mod(math.floor(variable.particle_random_1 * 40), 4)", 0],
					"uv_size": [16, 8]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"(variable.fluid_r ?? 0.66) * (0.75 + 0.45 * variable.particle_random_3)",
					"(variable.fluid_g ?? 0.03) * (0.75 + 0.45 * variable.particle_random_3)",
					"(variable.fluid_b ?? 0.03) * (0.75 + 0.45 * variable.particle_random_3)",
					1
				]
			},
			"minecraft:particle_appearance_lighting": {}
