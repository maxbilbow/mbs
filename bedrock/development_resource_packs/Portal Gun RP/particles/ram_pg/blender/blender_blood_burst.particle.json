{
	"format_version": "1.21.10",
	"particle_effect": {
		"description": {
			"identifier": "ram_pg:blender_blood_burst",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/ram_pg/particles/blender/blood_droplet"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 160
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
