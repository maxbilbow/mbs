{
	"format_version": "1.21.10",
	"particle_effect": {
		"description": {
			"identifier": "ram_pg:target_marker_spark",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/ram_pg/particles/target/target"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.color ?? { variable.color.r = 0.45; variable.color.g = 1.0; variable.color.b = 0.35; };"
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 12
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.05
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.55,
				"surface_only": true,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.3 + 0.15 * variable.particle_random_1"
			},
			"minecraft:particle_initial_speed": "1.6 + 0.5 * variable.particle_random_2",
			"minecraft:particle_motion_dynamic": {
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.02 + 0.045 * (1 - (variable.particle_age / variable.particle_lifetime))",
					"0.02 + 0.045 * (1 - (variable.particle_age / variable.particle_lifetime))"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 16,
					"uv": [
						16,
						0
					],
					"uv_size": [
						16,
						16
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"math.lerp(1, variable.color.r, (variable.particle_age / variable.particle_lifetime))",
					"math.lerp(1, variable.color.g, (variable.particle_age / variable.particle_lifetime))",
					"math.lerp(1, variable.color.b, (variable.particle_age / variable.particle_lifetime))",
					"1 - (variable.particle_age / variable.particle_lifetime) * (variable.particle_age / variable.particle_lifetime)"
				]
			}
		}
	}
}
