				"rotation": "360 * variable.particle_random_4"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.26 + 0.22 * variable.particle_random_3",
					"0.26 + 0.22 * variable.particle_random_3"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 64,
					"uv": [
						"32 * math.floor(math.mod(variable.particle_random_1 * 4 + variable.particle_age * 25, 4))",
						0
					],
					"uv_size": [
						32,
						32
					]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					1,
					1,
					1,
					"(math.random(0, 1) > 0.3 ? 1 : 0.35) * (1 - math.pow((variable.particle_age / variable.particle_lifetime), 2))"
				]
			}
		}
	}
