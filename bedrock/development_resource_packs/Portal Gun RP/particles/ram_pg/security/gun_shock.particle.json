{
	"format_version": "1.21.10",
	"particle_effect": {
		"description": {
			"identifier": "ram_pg:gun_shock",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/ram_pg/particles/security/shock"
			}
		},
		"events": {
			"burst": {
				"sequence": [
					{
						"particle_effect": {
							"effect": "ram_pg:gun_shock_flash",
							"type": "emitter"
						}
					},
					{
						"particle_effect": {
							"effect": "ram_pg:gun_shock_spark",
							"type": "emitter"
						}
					}
				]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 45,
				"max_particles": 16
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.3
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "burst"
			},
			"minecraft:emitter_shape_point": {
				"offset": [
					"0.42 * math.cos(360 * variable.particle_random_1)",
					"1.7 * variable.particle_random_2 - 0.85",
