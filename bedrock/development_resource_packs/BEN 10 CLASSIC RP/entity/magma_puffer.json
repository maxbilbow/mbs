{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "mob:magma_puffer",
			"min_engine_version": "1.8.0",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/entity/magma_puffer"
			},
			"geometry": {
				"default": "geometry.magma_puffer",
				"mid": "geometry.magma_puffer_mid_puff",
				"large": "geometry.magma_puffer_full_puff"
			},
			"scripts": {
				"pre_animation": [
					"variable.ZRot = !query.is_in_water ? Math.cos(query.time_stamp * 14.32) * 90 : 0.0;",
					"variable.AnimationAmountBlend = Math.lerp(variable.AnimationAmountPrev, variable.AnimationAmount, query.frame_alpha);"
				],
				"animate": [
					"general"
				]
			},
			"animations": {
				"flop": "animation.pufferfish.flop",
				"swim": "animation.magma_puffer.general",
				"general": "controller.animation.fish.general"
			},
			"render_controllers": [
				{
					"controller.render.pufferfish.small": "query.variant==0"
				},
				{
					"controller.render.pufferfish.medium": "query.variant==1"
				},
				{
					"controller.render.pufferfish.large": "query.variant==2"
				}
			],
			"spawn_egg": {
				"base_color": "#371D0B",
				"overlay_color": "#6A5611"
			}
		}
	}
}