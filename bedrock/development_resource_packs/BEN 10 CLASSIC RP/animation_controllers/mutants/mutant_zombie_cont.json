		"controller.animation.mzombie.general": {
			"initial_state": "default",
			"states": {
				"crouch": {
					"animations": [
						"roaring"
					],
					"blend_transition": 0,
					"transitions": [
						{
							"throw": "query.is_roaring==1&&query.mark_variant==3"
						},
						{
							"death": "!query.is_alive"
						},
						{
							"default": "query.all_animations_finished&&!query.is_casting"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"smash_attack": {
					"animations": [
						"look_at_target",
						"smash_attack"
					],
					"blend_transition": 0.4,
					"transitions": [
						{
							"throw": "query.is_roaring==1&&query.mark_variant==3"
						},
						{
							"death": "!query.is_alive"
						},
						{
							"default": "!query.is_casting"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"throw": {
					"animations": [
						"look_at_target",
						"throw"
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"throw_success": "query.is_roaring==1&&query.mark_variant==4"
						},
						{
							"death": "!query.is_alive"
						},
						{
							"default": "!query.has_target||query.all_animations_finished&&query.is_on_ground"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"throw_success": {
					"animations": [
						"look_at_target",
						"throw_success"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished"
						},
						{
							"death": "!query.is_alive"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"default": {
					"animations": [
						"idle",
						"look_at_target"
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"crouch": "query.is_casting&&query.mark_variant==2"
						},
						{
							"smash_attack": "query.is_casting"
						},
						{
							"throw": "query.is_roaring==1&&query.mark_variant==3"
						},
						{
							"death": "!query.is_alive"
						},
						{
							"pounce": "query.is_swimming"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"death": {
					"transitions": [
						{
							"default": "query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"pounce": {
					"animations": [
						"idle",
						"look_at_target",
						"swimming"
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!query.is_swimming"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"stuck": {
					"animations": [
						"stunned"
					],
					"blend_transition": 0.3,
					"transitions": [
						{
							"death": "!query.is_alive"
						},
						{
							"default": "query.is_stunned==0"
						}
					]
				}
			}
		},
