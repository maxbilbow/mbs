{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.mob_endolotl.move": {
			"initial_state": "idling",
			"states": {
				"idling": {
					"animations": [
						{
							"fly": "math.min(1,query.modified_move_speed*10)"
						},
						"look_at_target",
						"idle"
					],
					"transitions": [
						{
							"play_dead": "query.is_playing_dead"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.4
				},
				"play_dead": {
					"animations": [
						"look_at_target",
						"idle",
						"play_dead"
					],
					"transitions": [
						{
							"play_alive": "!query.is_playing_dead"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"play_alive": {
					"animations": [
						"look_at_target",
						"idle",
						"play_alive"
					],
					"transitions": [
						{
							"idling": "query.all_animations_finished"
						},
						{
							"play_dead": "query.is_playing_dead"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"death": {
					"animations": [
						"death",
						"death_cancel"
					],
					"blend_transition": 0.3
				}
			}
		},
		"controller.animation.mob_endolotl.idle": {
			"states": {
				"default": {
					"transitions": [
						{
							"idle_1": "math.random(0,2300)<1&&!query.is_angry&&query.is_sitting&&!query.is_roaring&&!query.has_target&&query.is_alive"
						},
						{
							"idle_2": "math.random(0,2600)<1&&!query.is_angry&&!query.is_roaring&&!query.has_target&&query.is_alive"
						},
						{
							"idle_3": "math.random(0,3100)<1&&!query.is_angry&&!query.is_roaring&&query.is_playing_dead&&!query.has_target&&query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"idle_1": {
					"animations": [
						"idle_1"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished||query.is_angry||query.has_target||query.is_roaring||!query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"idle_2": {
					"animations": [
						"idle_2"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished||query.is_angry||query.has_target||query.is_roaring||!query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"idle_3": {
					"animations": [
						"idle_3"
					],
					"transitions": [
						{
							"default": "query.all_animations_finished||query.is_angry||query.has_target||query.is_sitting||query.is_playing_dead||query.is_roaring||!query.is_alive"
						}
					]
				}
			}
		},
		"controller.animation.mendolotl.portal": {
			"initial_state": "default",
