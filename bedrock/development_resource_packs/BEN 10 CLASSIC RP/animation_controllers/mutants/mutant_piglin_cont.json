		"controller.animation.mpiglin.general": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"idle": "query.skin_id==1||query.skin_id==0"
						},
						{
							"idle_bob_crossbow": "query.skin_id==3"
						},
						"look_at_target"
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"melee_attack": "variable.attack_time!=0&&query.skin_id==0"
						},
						{
							"sword_attack": "query.is_roaring==1&&query.skin_id==1"
						},
						{
							"cannon_mode": "query.is_alive&&query.has_target&&query.skin_id==3"
						},
						{
							"death": "!query.is_alive"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"admire": {
					"animations": [
						"idle",
						"look_at_target",
						"admire"
					],
					"transitions": [
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"default": "!query.is_admiring"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.4
				},
				"celebrate": {
					"animations": [
						"idle",
						"look_at_target",
						"celebrate"
					],
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"default": "!query.is_celebrating"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.4
				},
				"celebrate_special": {
					"animations": [
						"idle",
						"look_at_target",
						"celebrate_special"
					],
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"default": "!query.is_celebrating_special"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.4
				},
				"melee_attack": {
					"animations": [
						"look_at_target",
						"melee_attack"
					],
					"transitions": [
						{
							"default": "variable.attack_time==0&&query.is_alive"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.4
				},
				"sword_attack": {
					"animations": [
						"look_at_target",
						"sword_attack"
					],
					"blend_transition": 0.4,
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"default": "!query.is_roaring"
						},
						{
							"stuck": "query.is_stunned==1"
						}
					]
				},
				"cannon_mode": {
					"animations": [
						"look_at_target",
						"aim"
					],
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"default": "query.all_animations_finished&&!query.is_alive"
						},
						{
							"cannon_mode_still": "query.all_animations_finished&&query.is_alive"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.4
				},
				"cannon_mode_still": {
					"animations": [
						"look_at_target",
						"aim_still"
					],
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"default": "query.all_animations_finished&&!query.is_alive"
						},
						{
							"cannon_switch": "!query.has_target||query.skin_id!=3||!query.is_alive"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"shoot": "variable.attack_time!=0"
						},
						{
							"death": "!query.is_alive"
						}
					]
				},
				"cannon_switch": {
					"animations": [
						"look_at_target",
						"uncharge"
					],
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"default": "query.all_animations_finished&&query.is_alive"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"shoot": {
					"animations": [
						"look_at_target",
						"aim_shoot"
					],
					"transitions": [
						{
							"admire": "query.is_admiring"
						},
						{
							"celebrate": "query.is_celebrating"
						},
						{
							"celebrate_special": "query.is_celebrating_special"
						},
						{
							"cannon_switch": "query.all_animations_finished&&!query.has_target&&query.skin_id!=3||!query.is_alive"
						},
						{
							"cannon_mode_still": "query.all_animations_finished"
						},
						{
							"stuck": "query.is_stunned==1"
						},
						{
							"death": "!query.is_alive"
						}
					]
				},
				"death": {
					"transitions": [
						{
							"default": "query.is_alive"
						}
					],
					"blend_transition": 0.3
				},
				"stuck": {
					"animations": [
						"stunned"
					],
					"blend_transition": 0,
					"transitions": [
						{
							"default": "query.is_stunned==0"
						}
					]
				}
			}
		},
