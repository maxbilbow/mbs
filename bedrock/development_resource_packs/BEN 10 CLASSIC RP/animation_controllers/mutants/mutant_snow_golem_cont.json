{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.msnowgolem.general": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						"idle",
						"look_at_target"
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"death": "!query.is_alive"
						},
						{
							"range_attack": "query.is_charged"
						}
					]
				},
				"range_attack": {
					"animations": [
						"range",
						"idle",
						"look_at_target"
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"default": "query.all_animations_finished"
						},
						{
							"death": "!query.is_alive"
						}
					]
				},
				"death": {
					"animations": [
						"death",
						"death_cancel"
					],
					"blend_transition": 0.4,
					"transitions": [
						{
							"default": "query.is_alive"
						}
					]
				}
			}
		},
		"controller.animation.msnowgolem.walking": {
			"states": {
				"death": {
					"transitions": [
						{
							"default": "query.is_alive"
						}
					],
					"blend_transition": 0.15
				},
				"default": {
					"animations": [
						{
							"walk_arms": "math.min(1,query.modified_move_speed*10)"
						},
						{
							"walk": "math.min(1,query.modified_move_speed*10)"
						}
					],
					"transitions": [
						{
							"sitting": "query.is_sitting"
						},
						{
							"melee_attack": "variable.attack_time>0&&query.is_alive"
						},
						{
							"range_attack": "query.is_charged"
						}
					],
					"blend_transition": 0.15
				},
				"melee_attack": {
					"animations": [
						{
							"walk": "math.min(1,query.modified_move_speed*10)"
						},
						"attack"
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"default": "variable.attack_time<=0"
						},
						{
							"death": "!query.is_alive"
						}
					]
				},
				"range_attack": {
					"animations": [
						{
							"walk": "math.min(1,query.modified_move_speed*10)"
						}
					],
					"blend_transition": 0.15,
					"transitions": [
						{
							"default": "!query.is_charged"
						},
						{
							"death": "!query.is_alive"
						}
					]
				},
				"sitting": {
					"animations": [
						"sit"
					],
					"transitions": [
						{
							"default": "!query.is_sitting"
						},
						{
							"death": "!query.is_alive"
						}
					],
					"blend_transition": 0.15
				}
			}
		}
	}
}