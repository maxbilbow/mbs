				{
					"*": "material.default"
				}
			],
			"textures": [
				"array.skins[query.variant]"
			],
			"ignore_lighting": true,
			"part_visibility": [
				{
					"*": 0
				},
				{
					"eye": 1
				},
				{
					"eye2": 1
				},
