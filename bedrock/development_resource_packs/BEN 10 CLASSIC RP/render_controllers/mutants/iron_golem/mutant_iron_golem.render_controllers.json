{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.miron_golem": {
			"overlay_color": {
				"r": "(query.is_stunned)",
				"g": 0,
				"b": 0,
				"a": "(query.is_stunned*(0.45+math.cos(query.life_time*150-100)*0.15))"
			},
			"arrays": {
				"textures": {
					"Array.skins": [
						"Texture.default",
						"Texture.cherry_blossom",
						"Texture.glow_berry",
						"Texture.desert",
						"Texture.pale"
					]
				}
			},
			"geometry": "geometry.default",
			"materials": [
				{
					"*": "material.default"
				}
			],
			"textures": [
				"array.skins[query.variant]"
			]
		},
		"controller.render.miron_golem_eyes": {
			"arrays": {
				"textures": {
					"Array.skins": [
						"Texture.default",
