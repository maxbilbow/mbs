{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.mendolotl": {
			"is_hurt_color": {
				"r": 1,
				"g": 0,
				"b": 0,
				"a": "(query.is_alive*0.6)+(!query.is_alive*0.6)"
			},
			"overlay_color": {
				"r": "(query.is_playing_dead)",
				"g": 0,
				"b": 0,
				"a": "(query.is_playing_dead*0.6)"
			},
			"arrays": {
				"textures": {
					"Array.skins": [
						"Texture.vanilla",
						"Texture.hive"
					]
				}
			},
			"geometry": "geometry.default",
			"materials": [
				{
					"*": "material.default"
				},
				{
					"*arm": "material.limbs"
				},
				{
					"*leg": "material.limbs"
				}
			],
			"textures": [
				"array.skins[query.variant]"
			],
			"ignore_lighting": false
		}
	}
}