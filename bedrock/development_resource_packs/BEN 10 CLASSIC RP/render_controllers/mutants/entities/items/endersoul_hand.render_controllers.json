{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.item_mutant_endersoul_hand": {
			"geometry": "geometry.default",
			"materials": [
				{
					"*": "variable.is_enchanted?material.enchanted:material.default"
				}
			],
			"textures": [
				"texture.default",
				"texture.enchanted"
			],
			"ignore_lighting": true
		},
		"controller.render.item_mutant_endersoul_hand_glint": {
			"geometry": "geometry.glint",
			"materials": [
				{
					"*": "variable.is_enchanted?material.enchanted:material.glint"
				}
			],
			"textures": [
				"texture.glint",
				"texture.enchanted"
			],
			"ignore_lighting": true
		}
	}
}