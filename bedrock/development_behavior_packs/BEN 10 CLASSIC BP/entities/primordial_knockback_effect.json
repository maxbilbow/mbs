			"minecraft:type_family": {
				"family": [
					"wind_charge",
					"wind_charge_projectile"
				]
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"sequence": [
					{
						"filters": {
							"test": "is_underwater",
							"value": true
						},
						"add": {
							"component_groups": [
								"in_water"
							]
						}
					},
					{
						"filters": {
							"test": "is_underwater",
							"value": false
