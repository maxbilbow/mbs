{
	"format_version": "1.26.0",
	"minecraft:entity": {
		"description": {
			"identifier": "projectile:primordial_knockback_effect",
			"is_summonable": true,
			"is_spawnable": false,
			"runtime_identifier": "minecraft:wind_charge_projectile"
		},
		"components": {
			"minecraft:collision_box": {
				"height": 0.3125,
				"width": 0.3125
			},
