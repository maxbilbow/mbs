							"test": "is_underwater",
							"value": false
						}
					}
				},
				"minecraft:explode": {
					"knockback_scaling": 4,
					"damage_scaling": 0,
					"allow_underwater": true,
					"breaks_blocks": false,
					"causes_fire": false,
					"max_resistance": 0,
					"negates_fall_damage": true,
