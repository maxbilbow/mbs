					"reflect_immunity": 0.5,
					"gravity": 0,
					"inertia": 1,
					"ignored_entities": [
						"ender_crystal",
						"wind_charge_projectile",
						"breeze_wind_charge_projectile"
					],
					"multiple_targets": false,
					"liquid_inertia": 1,
					"on_hit": {
						"impact_damage": {
							"apply_knockback_to_blocking_targets": true,
							"damage": 1,
							"knockback": true,
