					"multiple_targets": false,
					"liquid_inertia": 1,
					"on_hit": {
						"impact_damage": {
							"apply_knockback_to_blocking_targets": true,
							"damage": 1,
							"knockback": true,
							"max_critical_damage": 1
						},
						"wind_burst_on_hit": {}
					},
					"power": 1.5,
					"reflect_on_hurt": true,
					"uncertainty_base": 1,
					"uncertainty_multiplier": 0
				}
			}
