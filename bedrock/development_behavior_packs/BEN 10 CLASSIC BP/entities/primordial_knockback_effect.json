				"default_values": {
					"max_dropped_ticks": 7,
					"max_optimized_distance": 80,
					"use_motion_prediction_hints": true
				}
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": true
