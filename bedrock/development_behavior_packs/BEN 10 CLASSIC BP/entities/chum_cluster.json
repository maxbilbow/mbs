{
	"format_version": "1.20.30",
	"minecraft:entity": {
		"description": {
			"identifier": "projectile:chum_cluster",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"runtime_identifier": "minecraft:snowball"
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.01,
				"height": 0.01
			},
			"minecraft:physics": {
				"has_gravity": false
			},
			"minecraft:type_family": {
				"family": [
					"magic",
					"inanimate"
				]
			},
			"minecraft:timer": {
				"looping": true,
				"time": [
					0.1,
					0.1
				],
				"time_down_event": {
					"event": "icespike"
				}
			}
		},
		"events": {
			"on:hit": {
				"sequence": [
					{
						"queue_command": {
							"command": [
								"tag @s add hit"
							]
						}
					},
					{
						"add": {
							"component_groups": [
								"explodetimer"
							]
						},
						"remove": {
							"component_groups": [
								"projectile"
							]
						}
					}
				]
			},
			"icespike": {
				"queue_command": {
					"command": [
						"execute as @e[family=predator] run execute at @s run tp @s[family=!boss] ^^^0.33 facing @e[c=1,r=16,type=projectile:chum_cluster]"
					]
				}
			},
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"projectile"
					]
				}
			},
			"despawn": {
				"add": {
					"component_groups": [
						"despawn"
					]
				}
			}
		},
		"component_groups": {
			"despawn": {
				"minecraft:instant_despawn": {}
			},
			"projectile": {
				"minecraft:projectile": {
					"on_hit": {
						"mob_effect": {
							"effect": {},
							"durationeasy": 200,
							"durationnormal": 200,
							"durationhard": 200,
							"amplifier": 1
						},
						"arrow_effect": {},
						"definition_event": {
							"affect_projectile": true,
							"eventTrigger": {
								"event": "despawn",
								"target": "self"
							}
						}
					},
					"liquid_inertia": 0.95,
					"power": 1.3,
					"gravity": 0.01,
					"angleoffset": 0
				}
			},
			"explodetimer": {
				"minecraft:explode": {
					"fuse_length": 5,
					"fuse_lit": true,
					"power": 8,
					"causes_fire": false,
					"destroy_affected_by_griefing": true
				}
			}
		}
	}
}