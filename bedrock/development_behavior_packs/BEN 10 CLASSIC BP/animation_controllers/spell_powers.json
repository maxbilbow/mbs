{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.spell_book_action": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"cast": "query.get_equipped_item_name('main_hand')=='spell_book'&&query.is_using_item"
						}
					],
					"on_entry": [
						"/event entity @s spell_shield_remove"
					]
				},
				"cast": {
					"transitions": [
						{
							"default": "!query.is_using_item||query.get_equipped_item_name('main_hand')!='spell_book'"
						}
					],
					"on_entry": [
						"/event entity @s[scores={spells=1}] shoot:spell_blast",
						"/event entity @s[scores={spells=2}] spell_shield",
						"/execute as @s[scores={spells=3}] at @s run tp @e[r=6,rm=1] ^^1^5 true",
						"/execute as @s[scores={spells=4}] at @s run ride @s summon_ride alien:fly",
						"/scoreboard players add @s[scores={spells=4}] fly 1"
					]
				}
			}
		}
	}
}