{
	"format_version": "1.13.0",
	"minecraft:feature_rules": {
		"description": {
			"identifier": "gen:rock_feature",
			"places_feature": "gen:scatter_rock_feature"
		},
		"conditions": {
			"placement_pass": "after_surface_pass",
			"minecraft:biome_filter": [
				{
					"any_of": [
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "overworld"
						}
					]
				},
				{
					"test": "has_biome_tag",
					"operator": "!=",
					"value": "cold"
				},
				{
					"test": "has_biome_tag",
					"operator": "!=",
					"value": "frozen"
				}
			]
		},
		"distribution": {
			"iterations": 15,
			"x": {
				"distribution": "uniform",
				"extent": [
					0,
					16
				]
			},
			"y": "query.heightmap(variable.worldx, variable.worldz)",
			"z": {
				"distribution": "uniform",
				"extent": [
					0,
					16
				]
			}
		}
	}
}