{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "gen:no_leaf_litter_feature",
      "places_feature": "generation:no_leaf_litter_feature"
    },
    "conditions": {
      "placement_pass": "after_surface_pass",
      "minecraft:biome_filter": [
        {
					"any_of": [
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "forest"
						}
					]
				},
				{
					"test": "has_biome_tag",
					"operator": "!=",
					"value": "forest_generation"
				}
			]
		},
    "distribution": {
      "iterations": 100,
      "coordinate_eval_order": "zyx",
      "x": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      },
      "y": {
        "distribution": "uniform",
        "extent": [ 55, 80 ]
      },
      "z": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      }
    }
  }
}
